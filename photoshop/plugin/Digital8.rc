#include <winres.h>
#include "resources.h"
#pragma code_page(65001)
IDD_SETTINGS DIALOGEX 0,0,374,306
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Digital8 Native 0.2.4"
FONT 9,"Yu Gothic UI"
BEGIN
    LTEXT "機種",-1,12,12,28,12
    COMBOBOX IDC_MACHINE,43,9,92,100,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT "パレット",-1,145,12,38,12
    COMBOBOX IDC_PALETTE,184,9,177,180,CBS_DROPDOWNLIST | CBS_OWNERDRAWFIXED | CBS_HASSTRINGS | WS_VSCROLL | WS_TABSTOP
    CONTROL "",IDC_PALETTE_GRID,"STATIC",SS_OWNERDRAW | SS_NOTIFY,12,34,349,39
    LTEXT "",IDC_PALETTE_INFO,12,80,267,13
    CONTROL "色を編集…",IDC_EDIT_COLOUR,"BUTTON",BS_OWNERDRAW | WS_TABSTOP,286,77,75,19
    CONTROL "共通",IDC_PAGE_COMMON,"BUTTON",BS_OWNERDRAW | WS_TABSTOP,12,102,87,18
    CONTROL "面の塗り分け",IDC_PAGE_FILL,"BUTTON",BS_OWNERDRAW | WS_TABSTOP,99,102,87,18
    CONTROL "タイル",IDC_PAGE_PATTERN,"BUTTON",BS_OWNERDRAW | WS_TABSTOP,186,102,87,18
    CONTROL "色補正",IDC_PAGE_COLOUR,"BUTTON",BS_OWNERDRAW | WS_TABSTOP,273,102,88,18
    AUTOCHECKBOX "縦長ドット",IDC_TALL,18,224,87,14
    AUTOCHECKBOX "色トレス",IDC_TRACE,110,224,76,14
    AUTOCHECKBOX "透明度を二値化",IDC_ALPHA,192,224,135,14
    AUTOCHECKBOX "白を透明にする",IDC_WHITE,18,240,160,14
    LTEXT "1:1",1400,18,133,55,12
    COMBOBOX IDC_HALF,140,130,208,100,CBS_DROPDOWNLIST | WS_TABSTOP
    LTEXT "3:1",1401,18,155,55,12
    COMBOBOX IDC_QUARTER,140,152,208,100,CBS_DROPDOWNLIST | WS_TABSTOP
    LTEXT "7:1",1402,18,177,55,12
    COMBOBOX IDC_EIGHTH,140,174,208,100,CBS_DROPDOWNLIST | WS_TABSTOP
    LTEXT "3色 1:1:2",1403,18,199,95,12
    COMBOBOX IDC_THREE112,140,196,208,100,CBS_DROPDOWNLIST | WS_TABSTOP
    LTEXT "3色 1:1:1",1404,18,221,95,12
    COMBOBOX IDC_THREE111,140,218,208,100,CBS_DROPDOWNLIST | WS_TABSTOP
    AUTOCHECKBOX "4色 4×2 を使う",IDC_FOUR_COLOUR,18,241,145,14
    AUTOCHECKBOX "5色 4×4 を使う",IDC_FIVE_COLOUR,190,241,145,14
    LTEXT "設定を変更したらプレビューを更新してください。",IDC_STATUS,12,260,349,18
    CONTROL "プレビュー更新",IDC_PREVIEW,"BUTTON",BS_OWNERDRAW | WS_TABSTOP,112,282,103,20
    CONTROL "適用",IDOK,"BUTTON",BS_OWNERDRAW | WS_TABSTOP,226,282,63,20
    CONTROL "キャンセル",IDCANCEL,"BUTTON",BS_OWNERDRAW | WS_TABSTOP,298,282,63,20
END
// Photoshop looks up this literal resource name; a numeric PiPL ID is not
// interchangeable with the JSON_PIPL name used by the current SDK.
JSON_PIPL JSON "PiPLs.json"

VS_VERSION_INFO VERSIONINFO
FILEVERSION 0,2,4,0
PRODUCTVERSION 0,2,4,0
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEFLAGS 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_DLL
FILESUBTYPE 0
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "FileDescription", "Digital8 Native Photoshop Filter\0"
            VALUE "FileVersion", "0.2.4\0"
            VALUE "ProductName", "Digital8 Native\0"
            VALUE "ProductVersion", "0.2.4\0"
            VALUE "OriginalFilename", "Digital8.8bf\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
