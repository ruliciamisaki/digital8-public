{
  "manifestVersion": 5,
  "id": "digital8-native-panel-dev",
  "name": "Digital8 Native Panel",
  "version": "0.3.23",
  "main": "index.html",
  "host": {
    "app": "PS",
    "minVersion": "25.10.0",
    "data": {
      "apiVersion": 2
    }
  },
  "entrypoints": [
    {
      "type": "panel",
      "id": "digital8",
      "label": {
        "default": "Digital8"
      },
      "minimumSize": {
        "width": 300,
        "height": 380
      },
      "maximumSize": {
        "width": 1200,
        "height": 1800
      },
      "preferredDockedSize": {
        "width": 340,
        "height": 700
      },
      "preferredFloatingSize": {
        "width": 390,
        "height": 760
      }
    }
  ]
}
